# ---- Database ----
DATABASE_URL=postgresql+psycopg://studysphere:studysphere@localhost:5432/studysphere

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRE_MINUTES=120
# Leave empty to DISABLE admin self-registration (admins then come only from seed.py).
# If set, a person registering with this code becomes faculty/admin.
ADMIN_INVITE_CODE=
# Comma-separated. Leave empty to allow any email domain (dev only).
ALLOWED_EMAIL_DOMAINS=svkmit.ac.in

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Uploads ----
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=25

# ---- Seed (demo data only) ----
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STUDENT_PASSWORD=Student@12345

# ---- AI ----
# Providers: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini
# Leave empty to use the provider's default model.
LLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings: "local" (sentence-transformers, free, offline after first download)
# or "hashing" (no download, keyword-level quality - only for quick demos/tests).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.30
